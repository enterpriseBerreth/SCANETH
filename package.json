{
  "name": "scaneth",
  "version": "1.0.0",
  "description": "SCANETH — Smart Contract Analyzer for New Ethereum Tokens. Watches Ethereum mainnet for fresh ERC-20 launches, scores them for risk, and alerts on low-risk tokens.",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "backtest": "tsx src/index.ts",
    "telegram:test": "tsx src/scaneth/telegram-test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0"
  }
}
