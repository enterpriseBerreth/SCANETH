{
  "name": "arbo",
  "version": "1.0.0",
  "description": "ARBO - crypto arbitrage bot: atomic flash-loan DEX arbitrage + cross-venue CEX spread scanner",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx src/tools/doctor.ts",
    "telegram:test": "tsx src/tools/telegram-test.ts",
    "test": "tsx src/onchain/profit.test.ts && tsx src/paper.test.ts",
    "test:profit": "tsx src/onchain/profit.test.ts",
    "test:paper": "tsx src/paper.test.ts",
    "bench:rpc": "node scripts/bench-rpc.mjs",
    "scan:once": "tsx src/index.ts --once",
    "deploy:contract": "node scripts/deploy-contract.mjs"
  },
  "dependencies": {
    "ccxt": "^4.4.36",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "solc": "0.8.26"
  }
}
