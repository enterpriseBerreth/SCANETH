# ─────────────────────────────────────────────────────────────
#  SCANETH — environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Ethereum RPC endpoint. A paid endpoint (Alchemy / Infura / QuickNode) is
# recommended because scanning every block with event logs consumes call budget.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# WebSocket endpoint for real-time block streaming. Strongly recommended.
# ETHEREUM_WS_URL=wss://ethereum-rpc.publicnode.com

# HTTP server port for Railway healthchecks.
PORT=3000

# Alert filters
# Max age (hours) of the DEXScreener pair to still alert.
MAX_AGE_HOURS=6
# Minimum transactions in the past hour to alert.
MIN_H1_TXNS=10
# Minimum sells in the past hour to alert.
MIN_H1_SELLS=1
# Max risk score (0-100) to alert.
ALERT_RISK_SCORE=100

# How often to poll for new blocks when no WebSocket URL is provided.
POLL_INTERVAL_MS=12000

# Optional fixed starting block. Leave blank to start at the current head.
# START_BLOCK=21000000

# Optional backtest range. When both are set the bot scans the range and exits.
# BACKTEST_FROM=21000000
# BACKTEST_TO=21000010

# Telegram credentials. Set these in Railway dashboard; never commit real values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Send a test alert on boot.
TELEGRAM_TEST_ON_BOOT=true

# Set to false to disable scanning while still serving HTTP healthchecks.
SCANETH_ENABLED=true

# Logging: debug | info | warn | error
LOG_LEVEL=info
