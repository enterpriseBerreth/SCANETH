# ─────────────────────────────────────────────────────────────
#  ARBO — environment configuration
#  Copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Execution mode ──
# simulate = scan and score only. Nothing is recorded.
# paper    = scan, then re-quote each candidate on-chain after a delay and book
#            the result to a persistent ledger. NEVER sends a transaction.
# live     = will submit real flash-loan transactions. Requires
#            ARB_CONTRACT_<CHAIN> and EXECUTOR_PRIVATE_KEY to be set.
MODE=paper

# ── Paper trading ──
# Ledger of settled paper trades, appended as newline-delimited JSON.
# On Railway this MUST point at a mounted volume (/data), otherwise the track
# record is wiped on every redeploy and long-run profitability can never be
# measured — which is the entire point of running in paper mode.
PAPER_LEDGER_PATH=./data/paper-trades.jsonl
# Simulated opening balance. Every settled trade debits or credits this, so the
# account compounds exactly as a real one would and P&L percent is measured
# against capital actually at risk. Flash loans are uncollateralised, so this is
# not a cap on trade size — it is the gas warchest, and it is what runs out.
PAPER_STARTING_CAPITAL_USD=1000
# How long a candidate is held before being re-quoted and booked. Detection to
# inclusion spans signing, propagation and at least one block, so settling
# instantly would measure nothing and report a fill rate near 100%.
PAPER_SETTLE_DELAY_MS=3000
# Optional paper-only profit floor. Set this LOWER than MIN_PROFIT_USD so paper
# mode gathers evidence on smaller edges without changing the live send safety
# threshold. Example: PAPER_MIN_PROFIT_USD=0.50
#PAPER_MIN_PROFIT_USD=
# Cadence of the cumulative report and the market-conditions rollup.
PAPER_REPORT_INTERVAL_MS=300000

# ── Chains ──
# Comma separated. Supported: base, arbitrum, optimism, ethereum
ENABLED_CHAINS=base,arbitrum,optimism

# RPC endpoints. These defaults are benchmarked, not guessed — verify with
# `node scripts/bench-rpc.mjs`. Note that base.org throttles hard: it measured
# 2170ms against 263ms for the default below, which alone turned a Base scan
# pass into 49 seconds. A paid endpoint (Alchemy / Infura / QuickNode) is still
# strongly recommended for MODE=live, because arbitrage is latency sensitive.
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://optimism-rpc.publicnode.com
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# ── WebSocket endpoints (optional, but the single biggest latency win) ──
# When set, scans are triggered by new blocks instead of a timer. Arbitrage state
# is only valid for one block, so a timer means most scans describe a market that
# has already moved. Without these the bot polls block numbers instead — still
# block-aligned, just later.
# Most providers expose wss:// on the same host as their https:// endpoint.
# BASE_WS_URL=wss://base-rpc.publicnode.com
# ARBITRUM_WS_URL=wss://arbitrum-one-rpc.publicnode.com
# OPTIMISM_WS_URL=wss://optimism-rpc.publicnode.com
# Fallback block-poll cadence used only for chains with no WS URL.
BLOCK_POLL_INTERVAL_MS=2000

# Optional: private / MEV-protected endpoint used ONLY for submitting
# transactions (e.g. Flashbots Protect, MEV Blocker). Reading still uses
# the RPC above. Leave blank to submit via the normal RPC.
PRIVATE_SUBMIT_RPC_URL=

# Optional: only scan these pairs per chain. Format:
#   FOCUS_PAIRS=base:WETH/USDC,arbitrum:WETH/LINK
# When set, all other pairs and triangular search are skipped, which cuts RPC
# usage dramatically. Use this after research identifies the one pair near
# profitability. Leave blank to scan every configured pair.
#FOCUS_PAIRS=

# ── Flash-loan contract (per chain) ──
# Deploy with: npm run deploy:contract
# Leave blank until deployed — the bot will stay in scan-only mode.
ARB_CONTRACT_BASE=
ARB_CONTRACT_ARBITRUM=
ARB_CONTRACT_ETHEREUM=

# Executor wallet. Only needed for MODE=live. Must be the contract owner.
EXECUTOR_PRIVATE_KEY=

# ── Profitability thresholds ──
# Minimum net profit (after flash fee, swap fees AND gas) to act on.
MIN_PROFIT_USD=5
# Largest flash-loan notional the bot will ever request, in USD.
MAX_TRADE_USD=25000
# Smallest notional to bother probing, in USD.
MIN_TRADE_USD=200
# Slippage tolerance applied to the on-chain minOut guards, in basis points.
SLIPPAGE_BPS=30
# Pools holding less than this are excluded entirely, and this matters more than
# it sounds. Abandoned pools exist at every V3 fee tier; because correcting them
# costs more gas than they hold, nobody ever arbitrages them back to fair value,
# so they sit at arbitrary prices forever. Left in, they generated phantom edges
# of 100%+ (one live Base DAI/USDC pool quoted a rate off by 1e8) and consumed
# the entire quote budget. Lower this only if you understand that trade-off.
MIN_POOL_LIQUIDITY_USD=25000

# ── Risk controls ──
# Bot halts for the rest of the UTC day once realised losses hit this.
MAX_DAILY_LOSS_USD=100
# Halt after this many consecutive failed/reverted executions.
MAX_CONSECUTIVE_FAILURES=5
# Cooldown after a failure, milliseconds.
FAILURE_COOLDOWN_MS=60000
# Emergency stop. Set to true to force the bot to stop trading.
KILL_SWITCH=false

# ── Scanning ──
SCAN_INTERVAL_MS=4000
# Gas units assumed for a 2-leg flash-loan arb when costing opportunities.
GAS_LIMIT_ESTIMATE=520000

# ── CEX spread scanner (public market data, no API keys needed) ──
CEX_ENABLED=true
CEX_EXCHANGES=binance,kraken,coinbase,okx,bybit
CEX_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,ARB/USDT
CEX_MIN_SPREAD_BPS=30
CEX_SCAN_INTERVAL_MS=15000
# Assumed round-trip transfer/withdrawal cost in bps, subtracted from spreads
# so the numbers reported are actually achievable rather than fantasy.
CEX_TRANSFER_COST_BPS=15

# ── Alerts (optional) ──
# Exactly one alert is sent per SETTLED TRADE, carrying token, PNL $, PNL %, and
# capital before and after. Nothing else is alerted: not startup, not detected
# opportunities, not CEX spreads — those are logs. The only exception is an
# operational halt, because a stopped bot is indistinguishable from a quiet
# market until you look.
# Verify delivery with:  npm run telegram:test
# Telegram refuses messages to a chat that has never contacted the bot, so send
# it /start once before expecting alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send a connectivity probe on every boot. Off by default so redeploys do not
# fill the chat with messages that have no trade behind them.
TELEGRAM_TEST_ON_BOOT=false

# ── Ops ──
PORT=3000
LOG_LEVEL=info
